<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <h3 class="mb-4">🏠 Bookings on Your Listings</h3>

  <% if(bookings.length === 0) { %>
    <div class="alert alert-info">
      No bookings yet.   
    </div>
  <% } %>

  <div class="row">
    <% for(let b of bookings) { %>

      <div class="col-md-6 col-lg-4 mb-4 card">
        <div class="card shadow-sm booking-card h-100">

          <!-- Image -->
          <img 
            src="<%= b.listing.image.url %>" 
            class="card-img-top booking-img"
            alt="listing image"
          >

          <div class="card-body">

            <h5 class="card-title"><%= b.listing.title %></h5>

            <p class="text-muted mb-1">
              👤 <%= b.user.username %>
            </p>

            <p class="mb-1">
              📅 
              <%= b.checkIn.toDateString() %> → 
              <%= b.checkOut.toDateString() %>
            </p>

            <p class="fw-bold">
              ₹ <%= b.totalPrice.toLocaleString("en-IN") %>
            </p>

          </div>

        </div>
      </div>

    <% } %>
  </div>
</div>